[flake8]
ignore = E501, W503, E203
  # legend:
  # E501 - line too long (> 79 characters)
  # W503 - line break before binary operator
  # E203 - whitespace before ':' (conflicts with black)
max-line-length = 79
max-complexity = 18
select = B,C,E,F,W,T4,B9
per-file-ignores =
  # The `hip` backward-compatibility package is nothing but re-exports, and
  # the optional bindings can only be imported below the guard that decides
  # whether their wheel is installed.
  packages/hip-python/src/hip/__init__.py: F401, E402
