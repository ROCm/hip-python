[build-system]
requires = ["scikit-build-core>=0.11.2", "cython>=3.1.0"]
build-backend = "scikit_build_core.build"

[project]
name = "hip-python-interop"
dynamic = ["version"]
description = "CUDA API bindings for HIP interoperability (driver, runtime, NVRTC, cuFile/cufile, NVML/pynvml, NVTX/nvtx)"
readme = "README.md"
requires-python = ">=3.9"
license = "MIT"
license-files = ["LICENSE"]
dependencies = [
    "rocm-bindings-hip~=@HIP_PYTHON_DEP_VERSION@",
    # pynvml shim is backed by rocm.bindings.amdsmi and the nvtx shim by
    # rocm.bindings.roctx (both from rocm-bindings-systems). ROCm ships neither
    # amdsmi nor roctracer on Windows, so no rocm-bindings-systems wheel is
    # built there and requiring it unconditionally would make this wheel
    # uninstallable. The cuda.* bindings, which are the bulk of this package,
    # do not depend on it; only the pynvml and nvtx shims do, and importing
    # those on Windows raises.
    "rocm-bindings-systems~=@HIP_PYTHON_DEP_VERSION@; sys_platform != 'win32'",
]
authors = [
    {name = "Advanced Micro Devices, Inc.", email = "hip-python.maintainer@amd.com"},
]
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.9",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Cython",
    "Topic :: Software Development :: Libraries :: Python Modules",
]

[project.urls]
Homepage = "https://github.com/rocm/hip-python"
Documentation = "https://rocm.docs.amd.com/projects/hip-python/en/latest/"
Repository = "https://github.com/rocm/hip-python"

[tool.scikit-build]
minimum-version = "build-system.requires"
build-dir = "../build/{wheel_tag}/hip-python-interop"
cmake.source-dir = "."
cmake.build-type = "Release"
ninja.make-fallback = false
wheel.packages = ["src/cuda", "src/pynvml", "src/nvtx"]
metadata.version.provider = "scikit_build_core.metadata.regex"
metadata.version.input = "VERSION"
metadata.version.regex = "(?P<value>.*)"
build.targets = ["package_hip_python_interop"]
install.components = ["hip-python-interop"]

# Include .pxd files for cimport
sdist.include = [
    "VERSION",
    "cmake/HipPythonBuild.cmake",
    # Compiled Cython bindings + their cimport headers. Covers the generated
    # driver/runtime/nvrtc modules AND the hand-written cuFile interop layer
    # (cufile.pyx, cufile.pxd, cycufile.pxd).
    "src/cuda/bindings/*.pxd",
    "src/cuda/bindings/*.pyx",
    # Handcoded high-level cuda.core shim (pure Python; wheel inclusion is
    # handled by wheel.packages = ["src/cuda"]).
    "src/cuda/core/*.py",
    # Handcoded pynvml/NVML shim backed by rocm.bindings.amdsmi (pure Python;
    # wheel inclusion is handled by wheel.packages = ["src/pynvml"]).
    "src/pynvml/*.py",
    # Handcoded nvtx/NVTX shim backed by rocm.bindings.roctx (pure Python;
    # wheel inclusion is handled by wheel.packages = ["src/nvtx"]).
    "src/nvtx/*.py"
]

[tool.cibuildwheel]
build-verbosity = 1
