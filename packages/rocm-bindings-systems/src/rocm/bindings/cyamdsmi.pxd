#                                        frequency policy
# 
#  @return ::amdsmi_status_t
#          ::AMDSMI_STATUS_SUCCESS on success, non-zero on failure
cdef amdsmi_status_t amdsmi_get_cpu_rail_isofreq_policy(void * processor_handle,uint8_t * rail_isofreq_policy) except? AMDSMI_STATUS_INTERNAL_EXCEPTION nogil


