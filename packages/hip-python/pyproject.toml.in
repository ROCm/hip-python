[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "hip-python"
dynamic = ["version"]
description = "Python bindings for HIP and ROCm libraries (backward compatibility package)"
readme = "README.md"
requires-python = ">=3.9"
license = "MIT"
license-files = ["LICENSE"]
authors = [
    {name = "Advanced Micro Devices, Inc.", email = "hip-python.maintainer@amd.com"},
]
dependencies = [
    "rocm-bindings-hip~=@HIP_PYTHON_DEP_VERSION@",
    "rocm-bindings-core~=@HIP_PYTHON_DEP_VERSION@"
]
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.9",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Programming Language :: Python :: 3.14",
    "Topic :: Software Development :: Libraries :: Python Modules",
]

[project.optional-dependencies]
libraries = [
    "rocm-bindings-libraries~=@HIP_PYTHON_DEP_VERSION@"
]
systems = [
    "rocm-bindings-systems~=@HIP_PYTHON_DEP_VERSION@"
]
compiler = [
    "rocm-bindings-compiler~=@HIP_PYTHON_DEP_VERSION@"
]

[project.urls]
Homepage = "https://github.com/rocm/hip-python"
Documentation = "https://rocm.docs.amd.com/projects/hip-python/en/latest/"
Repository = "https://github.com/rocm/hip-python"
Issues = "https://github.com/rocm/hip-python/issues"

[tool.setuptools.packages.find]
where = ["src"]
include = ["hip*"]

[tool.setuptools.dynamic]
version = {file = "VERSION"}
