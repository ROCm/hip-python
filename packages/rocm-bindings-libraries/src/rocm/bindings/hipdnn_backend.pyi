def hipdnnGetEngineInfo_ext(handle, engineIndex, engineId, engineName, engineNameLen, pluginName, pluginNameLen, version, versionLen, type, typeLen):
    r"""Gets information about a loaded engine by index.

    Retrieves the id, name, version, type, and plugin name of the engine at the given index.
    Valid indices are 0 to numEngines-1 as returned by hipdnnGetEngineCount_ext.
    Engines are sorted alphabetically by name.

    This function uses a two-call pattern for string fields:
    1. First call: Pass all string buffers as `nullptr` to query required sizes.
       - Sets `nameLen`, `versionLen`, `typeLen`, and `pluginNameLen` to the required buffer sizes
         (including null terminator). Note: if any string buffer is null, all sizes are updated.

    2. Second call: Pass allocated buffers with sizes set from the first call.

    Args:
        handle (:py:obj:`~.hipdnnHandle`/:py:obj:`~.object`) -- *IN*:
            A valid hipDNN handle.

        engineIndex (:py:obj:`~.int`) -- *IN*:
            Zero-based index of the engine to query.

        engineId (:py:obj:`~.rocm.bindings.util.types.ListOfInt64`/:py:obj:`~.object`) -- *OUT*:
            Pointer where the engine ID will be stored, or `nullptr` to skip.

        engineName (:py:obj:`~.rocm.bindings.util.types.CStr`/:py:obj:`~.object`) -- *OUT*:
            Buffer for the engine name, or `nullptr` to query size.

        engineNameLen (:py:obj:`~.rocm.bindings.util.types.ListOfUInt64`/:py:obj:`~.object`) -- *IN,OUT*:
            Pointer to buffer size; updated with required size.

        pluginName (:py:obj:`~.rocm.bindings.util.types.CStr`/:py:obj:`~.object`) -- *OUT*:
            Buffer for the plugin name, or `nullptr` to query size.

        pluginNameLen (:py:obj:`~.rocm.bindings.util.types.ListOfUInt64`/:py:obj:`~.object`) -- *IN,OUT*:
            Pointer to buffer size; updated with required size.

        version (:py:obj:`~.rocm.bindings.util.types.CStr`/:py:obj:`~.object`) -- *OUT*:
            Buffer for the engine version, or `nullptr` to query size.

        versionLen (:py:obj:`~.rocm.bindings.util.types.ListOfUInt64`/:py:obj:`~.object`) -- *IN,OUT*:
            Pointer to buffer size; updated with required size.

        type (:py:obj:`~.rocm.bindings.util.types.CStr`/:py:obj:`~.object`) -- *OUT*:
            Buffer for the engine type string, or `nullptr` to query size.

        typeLen (:py:obj:`~.rocm.bindings.util.types.ListOfUInt64`/:py:obj:`~.object`) -- *IN,OUT*:
            Pointer to buffer size; updated with required size.

    Returns:
        A :py:obj:`~.tuple` of size 1 that contains (in that order):

        * :py:obj:`~.hipdnnStatus_t`: One of:
                - :py:obj:`~.HIPDNN_STATUS_SUCCESS`: Success.
                - :py:obj:`~.HIPDNN_STATUS_BAD_PARAM`: Invalid handle, null pointers, or out-of-range index.
                - :py:obj:`~.HIPDNN_STATUS_INTERNAL_ERROR`: Internal error.

    .. rubric:: C signature

