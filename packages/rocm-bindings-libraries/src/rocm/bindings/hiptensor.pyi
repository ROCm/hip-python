    """
    ...

def hiptensorCreateReduction(handle, descA, modeA, opA, descC, modeC, opC, descD, modeD, opReduce, descCompute):
    r"""Creates a hiptensorOperatorDescriptor_t object that encodes a tensor reduction of the form :math:`D = alpha * opReduce(opA(A)) + beta * opC(C)`.

    Args:
        handle (:py:obj:`~.hiptensorHandle`/:py:obj:`~.object`) -- *IN*:
            Opaque handle holding hipTensor's library context.

        descA (:py:obj:`~.hiptensorTensorDescriptor`/:py:obj:`~.object`) -- *IN*:
            The descriptor that holds the information about the data type, modes and strides of A.

        modeA (:py:obj:`~.rocm.bindings.util.types.ListOfInt`/:py:obj:`~.object`) -- *IN*:
            Array with 'nmodeA' entries that represent the modes of A.

        opA (:py:obj:`~.hiptensorOperator_t`) -- *IN*:
            Unary operator that will be applied to each element of A before it is further processed. The original data of this tensor remains unchanged.

        descC (:py:obj:`~.hiptensorTensorDescriptor`/:py:obj:`~.object`) -- *IN*:
            The descriptor that holds the information about the data type, modes and strides of C.

        modeC (:py:obj:`~.rocm.bindings.util.types.ListOfInt`/:py:obj:`~.object`) -- *IN*:
            Array with 'nmodeC' entries that represent the modes of C.

        opC (:py:obj:`~.hiptensorOperator_t`) -- *IN*:
            Unary operator that will be applied to each element of C before it is further processed. The original data of this tensor remains unchanged.

        descD (:py:obj:`~.hiptensorTensorDescriptor`/:py:obj:`~.object`) -- *IN*:
            Must be identical to descC for now.

        modeD (:py:obj:`~.rocm.bindings.util.types.ListOfInt`/:py:obj:`~.object`) -- *IN*:
            Must be identical to modeC for now.

        opReduce (:py:obj:`~.hiptensorOperator_t`) -- *IN*:
            binary operator used to reduce elements of A.

        descCompute (:py:obj:`~.hiptensorComputeDescriptor_t`) -- *IN*:
            All arithmetic is performed using this data type.

    Returns:
        A :py:obj:`~.tuple` of size 2 that contains (in that order):

        * :py:obj:`~.hiptensorStatus_t`: One of:
                - :py:obj:`~.HIPTENSOR_STATUS_NOT_SUPPORTED`: if operation is not supported.
                - :py:obj:`~.HIPTENSOR_STATUS_INVALID_VALUE`: if some input data is invalid (this typically indicates an user error).
                - :py:obj:`~.HIPTENSOR_STATUS_SUCCESS`: The operation completed successfully.
                - :py:obj:`~.HIPTENSOR_STATUS_NOT_INITIALIZED`: if the handle is not initialized.
        * :py:obj:`~.hiptensorOperationDescriptor`:
                This opaque struct gets allocated and filled with the information that encodes the requested tensor reduction operation.

    .. rubric:: C signature

    .. code-block:: c

        hiptensorStatus_t hiptensorCreateReduction(const hiptensorHandle_t handle, hiptensorOperationDescriptor_t * desc, const hiptensorTensorDescriptor_t descA, const int32_t[] modeA, hiptensorOperator_t opA, const hiptensorTensorDescriptor_t descC, const int32_t[] modeC, hiptensorOperator_t opC, const hiptensorTensorDescriptor_t descD, const int32_t[] modeD, hiptensorOperator_t opReduce, const hiptensorComputeDescriptor_t descCompute)
    """
