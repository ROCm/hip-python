def hiptensorElementwiseTrinaryExecute(handle, plan, alpha, A, beta, B, gamma, C, D, stream):
    r"""Executes element-wise tensor operation on three input tensors.

    This function computes the element-wise operation:

    .. math::

       D_{\Pi^C(i_0,i_1,...,i_n)} = \Phi_{ABC}(\Phi_{AB}(\alpha \Psi_A(A_{\Pi^A(i_0,i_1,...,i_n)}), \beta \Psi_B(B_{\Pi^B(i_0,i_1,...,i_n)})), \gamma \Psi_C(C_{\Pi^C(i_0,i_1,...,i_n)}))

    Args:
        handle (:py:obj:`~.hiptensorHandle`/:py:obj:`~.object`) -- *IN*:
            Opaque handle containing hipTensor's library context.

