def hiptensorElementwiseBinaryExecute(handle, plan, alpha, A, gamma, C, D, stream):
    r"""Executes element-wise tensor operation on two input tensors.

    This function computes the element-wise operation:

    .. math::

       D_{\Pi^C(i_0,i_1,...,i_n)} = \Phi_{AC}(\alpha \Psi_A(A_{\Pi^A(i_0,i_1,...,i_n)}), \gamma \Psi_C(C_{\Pi^C(i_0,i_1,...,i_n)}))

    Args:
        handle (:py:obj:`~.hiptensorHandle`/:py:obj:`~.object`) -- *IN*:
            Opaque handle containing hipTensor's library context.

