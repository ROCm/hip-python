[build-system]
requires = ["scikit-build-core>=0.11.2", "cython>=3.1.0"]
build-backend = "scikit_build_core.build"

[project]
name = "rocm-bindings-compiler"
dynamic = ["version"]
description = "Python bindings for ROCm compiler infrastructure (LLVM, Comgr, Clang)"
readme = "README.md"
requires-python = ">=3.9"
license = "MIT"
license-files = ["LICENSE"]
authors = [
    {name = "Advanced Micro Devices, Inc.", email = "hip-python.maintainer@amd.com"},
]
dependencies = [
    "rocm-bindings-core~=@HIP_PYTHON_DEP_VERSION@",
]
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.9",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Programming Language :: Python :: 3.14",
    "Programming Language :: Cython",
    "Topic :: Software Development :: Libraries :: Python Modules",
    "Topic :: Software Development :: Compilers",
]

[project.urls]
Homepage = "https://github.com/rocm/hip-python"
Documentation = "https://rocm.docs.amd.com/projects/hip-python/en/latest/"
Repository = "https://github.com/rocm/hip-python"

[tool.scikit-build]
minimum-version = "build-system.requires"
build-dir = "../build/{wheel_tag}/rocm-bindings-compiler"
cmake.source-dir = "."
cmake.build-type = "Release"
ninja.make-fallback = false
wheel.packages = ["src/rocm"]
metadata.version.provider = "scikit_build_core.metadata.regex"
metadata.version.input = "VERSION"
metadata.version.regex = "(?P<value>.*)"
build.targets = ["package_rocm_bindings_compiler"]
install.components = ["rocm-bindings-compiler"]

sdist.include = [
    "VERSION",
    "cmake/HipPythonBuild.cmake",
    "src/rocm/bindings/llvm/**/*.pxd",
    "src/rocm/bindings/llvm/**/*.pyx",
    "src/rocm/bindings/llvm/**/*.pyi",
    "bundled/libllvm/CMakeLists.txt",
    "bundled/libllvm/Target.cpp",
    "bundled/libllvm/gen_msvc_exports.py",
]
