# Template for the Sphinx TOC, rendered by the hip-python code generator.
#
# The generator reads this file (`_toc.yml.in.in`) and writes
# `_toc.yml.in` next to it, substituting every `@TOC_ENTRIES_<SECTION>@`
# placeholder below with the discovered per-subtree module list. Handcoded
# subtrees (User Guide, rocm-bindings-util, hip-python compat shim,
# Manual API) are listed inline and left unchanged.
#
# Placeholder convention: `@VAR@` (matches the `_version.py.in` style
# used elsewhere in the repo). Each placeholder expands to a multi-line
# YAML block of `      - file: python_api/<name>` entries (already
# indented to fit under `entries:`); the placeholder must therefore sit
# at column 0 on its own line.
#
# See `share/design/CODEGEN.md` for the broader output-scope contract.
defaults:
  numbered: False
  maxdepth: 6
root: index
subtrees:
  - caption: User Guide
    entries:
      - file: user_guide/0_install
      - file: user_guide/1_usage
      - file: user_guide/2_cuda_python_interop
      - file: user_guide/3_jit_compilation
      - file: user_guide/4_datatypes
      - file: user_guide/5_report_bugs
      - file: user_guide/6_license
  - caption: "rocm-bindings-util"
    entries:
      - file: python_api/rocm/bindings/util/index
  - caption: "rocm-bindings-hip"
    entries:
@TOC_ENTRIES_ROCM_BINDINGS_HIP@
  - caption: "rocm-bindings-libraries"
    entries:
@TOC_ENTRIES_ROCM_BINDINGS_LIBRARIES@
  - caption: "rocm-bindings-compiler"
    entries:
@TOC_ENTRIES_ROCM_BINDINGS_COMPILER@
  - caption: "hip-python-interop (CUDA compat)"
    entries:
@TOC_ENTRIES_HIP_PYTHON_INTEROP@
  - caption: "hip-python (legacy compat shim)"
    entries:
      - file: python_api/hip/index
  - caption: "Manual API"
    entries:
      - file: python_api_manual/_hip_helpers
      - file: python_api_manual/_util_types
      - file: python_api/rocm/comgr/index
  - caption: "Cython-level declarations (advanced — for cimport users)"
    entries:
@TOC_ENTRIES_CYTHON_LEVEL@
