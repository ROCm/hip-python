# Variables of the form ${<variable>} are substituted, currently the following
# list is supported:
#   - ${branch} (or {branch}) the name of the current branch
#   - ${url} (or {url}) github url of the current project
#   - ${project:<project_name>} base url of the documentation of <project_name>
#     based on intersphinx_mapping.
# These comments will also be removed.
defaults:
  numbered: False
  maxdepth: 6
root: index
subtrees:
  - caption: User Guide
    entries:
      - file: user_guide/0_install
      - file: user_guide/1_usage
      - file: user_guide/2_cuda_python_interop
      - file: user_guide/3_datatypes
      - file: user_guide/4_report_bugs
      - file: user_guide/5_license
  - caption: "rocm-bindings-util"
    entries:
      - file: python_api/rocm.bindings.util
  - caption: "rocm-bindings-hip"
    entries:
      - file: python_api/rocm.bindings.hip
      - file: python_api/rocm.bindings.hiprtc
  - caption: "rocm-bindings-libraries"
    entries:
      - file: python_api/rocm.bindings.hipblas
      - file: python_api/rocm.bindings.hipsolver
      - file: python_api/rocm.bindings.rccl
      - file: python_api/rocm.bindings.hiprand
      - file: python_api/rocm.bindings.hipfft
      - file: python_api/rocm.bindings.hipsparse
      - file: python_api/rocm.bindings.roctx
  - caption: "rocm-bindings-compiler"
    entries:
      - file: python_api/rocm.bindings.amd_comgr
  - caption: "hip-python-interop (CUDA compat)"
    entries:
      - file: python_api/cuda.bindings.driver
      - file: python_api/cuda.bindings.runtime
      - file: python_api/cuda.bindings.nvrtc
  - caption: "hip-python (legacy compat shim)"
    entries:
      - file: python_api/hip
  - caption: "Manual API"
    entries:
      - file: python_api_manual/_hip_helpers
      - file: python_api_manual/_util_types
      - file: python_api_manual/rocm.comgr
  - caption: "Cython-level declarations (advanced — for cimport users)"
    entries:
      - file: python_api/rocm.bindings.cyhip
      - file: python_api/rocm.bindings.cyhiprtc
      - file: python_api/rocm.bindings.cyhipblas
      - file: python_api/rocm.bindings.cyhipsolver
      - file: python_api/rocm.bindings.cyrccl
      - file: python_api/rocm.bindings.cyhiprand
      - file: python_api/rocm.bindings.cyhipfft
      - file: python_api/rocm.bindings.cyhipsparse
      - file: python_api/rocm.bindings.cyroctx
      - file: python_api/rocm.bindings.cyamd_comgr
      - file: python_api/cuda.bindings.cydriver
      - file: python_api/cuda.bindings.cyruntime
      - file: python_api/cuda.bindings.cynvrtc
