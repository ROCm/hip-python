// requires plugins: "Docker Pipeline", "Editable Choice"

pipeline {
    agent {
        docker {
            image 'ubuntu:20.04'
            args '--device=/dev/kfd --device=/dev/dri --group-add=video --ipc=host --cap-add=SYS_PTRACE --security-opt seccomp=unconfined'
        }
    }
    environment {
        CONDA_DIR = '/opt/conda'
    }
    parameters {
        editableChoice(
            choices: [
                '6.1.0',
                '6.0.0',
                '5.7.1',
                '5.7.0',
                '5.6.1',
                '5.6.0',
                '5.5.1',
                '5.5.0',
                '5.4.3',
            ],
            description: 'The ROCm version to target with the code generator.',
            name: 'ROCM_VER'
        )
        string defaultValue: 'codegen/base', description: 'The base branch from which to derive the new development branch.', name: 'BASE_BRANCH'
        editableChoice(
            choices: [
                'develop',
            ],
            description: 'The branch name will be constructed as `${DEVELOP_BRANCH_PREFIX}/rocm-rel-${ROCM_VER}`. `develop` is first to make it default.',
            name: 'DEVELOP_BRANCH_PREFIX'
        )
        editableChoice(
            choices: [
                "main",
            ],
            description: 'Obtain release repo CI scripts from this branch. First entry is default.',
            name: 'CI_BRANCH'
        )
        editableChoice(
            choices: [
                'main',
            ],
            description: 'The codegenerator branch to use.',
            name: 'CODEGENERATOR_BRANCH'
        )
        editableChoice(
            choices: [
                "mirror.math.ucdavis.edu",
                "archive.ubuntu.com",
            ],
            description: 'Use a different Ubuntu mirror; see https://launchpad.net/ubuntu/+archivemirrors. First is default.',
            name: 'UBUNTU_APT_MIRROR'
        )
        booleanParam (
            defaultValue: false,
            description: 'Save built docker container as image into local host docker registry.',
            name: 'SAVE_IMAGE'
        )
    }
    stages {
        stage('clean-ws') {
            steps {
                cleanWs()
            }
        }
        stage('get-code-generator') {
            steps {
                git branch: '${CODEGENERATOR_BRANCH}', credentialsId: 'ROCM_LLVM_PYTHON_DEV', url: 'https://github.com/AMD-AI/hip-python'
            }
        }
        stage('get-release-repo') {
            steps {
                sh '''#!/usr/bin/env bash
                sed -i "s,archive.ubuntu.com,${UBUNTU_APT_MIRROR},g" /etc/apt/sources.list
                apt-get update && apt-get -y install sudo
                '''
                withCredentials([
                    usernamePassword(credentialsId: 'ROCM_LLVM_PYTHON_DEV', passwordVariable: 'GITHUB_TOKEN', usernameVariable: 'GITHUB_USER'),
                    string(credentialsId: 'ROCM_LLVM_PYTHON_DEV_EMAIL', variable: 'GITHUB_EMAIL')
                ]) {
                    dir('recipes/python_cython/llvmc') {
                        sh 'bash ci/0-checkout-release-repo.sh'
                    }
                    dir('recipes/python_cython/llvmc/rocm-llvm-python-release-repo') {
                        sh '''#!/usr/bin/env bash
                        set -e
                        set -o xtrace
                        git config user.email "${GITHUB_EMAIL}"
                        git config user.name "${GITHUB_USER}"
                        git remote remove origin
                        git remote add origin https://${GITHUB_TOKEN}@github.com/RocmSoftwarePlatform/rocm-llvm-python
                        git fetch origin
                        git branch -a
                        '''
                    }
                }
            }
        }
        stage('install-rocm') {
            steps {
                dir('recipes/python_cython/llvmc') {
                    sh 'SET_TIMEZONE=1 bash ci/1-install-rocm.sh'
                }
            }
        }
        stage('save-image-1') {
            when {
               allOf {
                    environment name: 'SAVE_IMAGE', value: 'true'
                }
            }
            steps {
               dir('.') {
                  sh '''#!/usr/bin/env bash
                  # copy build folder content to /build so that it will be 
                  # on the docker image and we can continue working on it
                  rm -rf /build
                  mkdir /build
                  cp -r * /build/
                  '''
               }
               sh '''#!/usr/bin/env bash
               set -x
               apt-get update && apt-get -y install docker.io
               tag="build-${BUILD_ID}"
               tmp=$(basename $(cat /proc/1/cpuset))
               container_hash=$(echo $tmp | sed -e 's/docker-//' -e 's/.scope//')
               docker commit ${container_hash} jenkins/debug_rocm_llvm_python:${tag}
               # This is a workaround for image automatically getting deleted on the hpe server
               docker run -d -it --network=host --device=/dev/kfd --device=/dev/dri --group-add=video --ipc=host --cap-add=SYS_PTRACE --name debug_rocm_llvm_python_${tag} --security-opt seccomp=unconfined -v $HOME:/home/ jenkins/debug_rocm_llvm_python:${tag} /bin/bash
               docker stop debug_rocm_llvm_python_${tag}
               '''
            }
        }
        stage('generate-code') {
            steps {
                dir ('recipes/python_cython/llvmc/rocm-llvm-python-release-repo') {
                    sh '''#!/usr/bin/env bash
                    set -e
                    set -o xtrace
                    CODEGEN_BRANCH=${CODEGEN_BRANCH:-codegen/rocm-rel-${ROCM_VER}}
                    git branch -d ${CODEGEN_BRANCH} || true
                    git fetch origin
                    git push origin --delete ${CODEGEN_BRANCH} || true
                    git fetch origin
                    git branch ${CODEGEN_BRANCH}
                    git checkout ${CODEGEN_BRANCH}
                    '''
                }
                dir('recipes/python_cython/llvmc') {
                    // sh '''
                    // git branch main
                    // git branch --set-upstream-to=origin/main main
                    // ''' // seems to be sometimes required
                    sh 'bash ci/2-generate-code.sh'
                    sh 'bash ci/3-generate-hiprtc-runtime.sh'
                    sh 'bash ci/4-get-rocm-llvm-project-clang-bindings.sh'
                }
                dir ('recipes/python_cython/llvmc/rocm-llvm-python-release-repo') {
                    sh '''#!/usr/bin/env bash
                    set -e
                    set -o xtrace
                    git add rocm-llvm-python
                    if [[ -n $(git status --porcelain) ]]; then
                       CODEGEN_BRANCH=${CODEGEN_BRANCH:-codegen/rocm-rel-${ROCM_VER}}
                       git commit -m "generated code"
                       git push --set-upstream origin ${CODEGEN_BRANCH}
                    fi
                    '''
                }
            }
        }
        stage('create-conda-envs') {
            steps {
                dir('recipes/python_cython/llvmc/rocm-llvm-python-release-repo') {
                    sh 'bash ci/1-install-conda.sh'
                    sh 'bash ci/2-create-conda-envs.sh'
                }
            }
        }
        stage('save-image-2') {
            when {
               allOf {
                    environment name: 'SAVE_IMAGE', value: 'true'
                }
            }
            steps {
               dir('.') {
                  sh '''#!/usr/bin/env bash
                  # copy build folder content to /build so that it will be 
                  # on the docker image and we can continue working on it
                  rm -rf /build
                  mkdir /build
                  cp -r * /build/
                  '''
               }
               sh '''#!/usr/bin/env bash
               set -x
               apt-get update && apt-get -y install docker.io
               tag="build-${BUILD_ID}"
               tmp=$(basename $(cat /proc/1/cpuset))
               container_hash=$(echo $tmp | sed -e 's/docker-//' -e 's/.scope//')
               docker image rm -f ${container_hash} jenkins/debug_rocm_llvm_python:${tag} || true # ATT: remove stage 'save-image-1' image
               docker commit ${container_hash} jenkins/debug_rocm_llvm_python:${tag}
               # This is a workaround for image automatically getting deleted on the hpe server
               docker rm -f debug_rocm_llvm_python_${tag} || true # ATT: remove 'save-image-1' container
               docker run -d -it --network=host --device=/dev/kfd --device=/dev/dri --group-add=video --ipc=host --cap-add=SYS_PTRACE --name debug_rocm_llvm_python_${tag} --security-opt seccomp=unconfined -v $HOME:/home/ jenkins/debug_rocm_llvm_python:${tag} /bin/bash
               docker stop debug_rocm_llvm_python_${tag}
               '''
            }
        }
        stage('build-and-test') {
            steps {
                sh 'rocm-smi'
                dir('recipes/python_cython/llvmc/rocm-llvm-python-release-repo') {
                    sh '''#!/usr/bin/env bash
                    export LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/opt/rocm/lib
                    bash ci/3a-build-and-test-for-single-cpython-version.sh
                    '''
                    sh '''#!/usr/bin/env bash
                    set -e
                    set -o xtrace
                    CODEGEN_BRANCH=${CODEGEN_BRANCH:-codegen/rocm-rel-${ROCM_VER}}
                    git checkout ${CODEGEN_BRANCH}
                    DEVELOP_BRANCH=${DEVELOP_BRANCH:-develop/rocm-rel-${ROCM_VER}}
                    # remove local and origin branch if they exist
                    git branch -d ${DEVELOP_BRANCH} || true
                    git fetch origin
                    git push origin --delete ${DEVELOP_BRANCH} || true
                    git fetch origin
                    git branch ${DEVELOP_BRANCH}
                    git push --set-upstream origin ${DEVELOP_BRANCH}
                    '''
                }
            }
        }
    }
}
