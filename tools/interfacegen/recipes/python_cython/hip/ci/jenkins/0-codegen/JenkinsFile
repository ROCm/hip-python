pipeline {
    agent {
        docker { image 'ubuntu:20.04' }
    }
    parameters {
        choice(
            choices: [
                '6.0.0',
                '5.7.1',
                '5.7.0',
                '5.6.1',
                '5.5.1',
                '5.5.0',
                '5.4.3',
            ],
            description: 'The ROCm version to target with the code generator.',
            name: 'ROCM_VER'
        )
        string defaultValue: 'develop/rocm-rel-5.7.1', description: 'The base branch from which to derive the new development branch.', name: 'BASE_BRANCH'
    }
    stages {
        stage('clean-ws') {
            steps {
                cleanWs()
            }
        }
        stage('get-code-generator') {
            steps {
                git branch: 'main', credentialsId: '697c0516-4da1-4d20-85d8-9999a2ae99f4', url: 'https://github.com/AMD-AI/hip-python'
            }
        }
        stage('get-release-repo') {
            steps {
                sh 'apt-get update && apt-get -y install sudo'
                dir('recipes/python_cython/hip') {
                    sh 'bash ci/0-checkout-release-repo.sh'
                }
            }
        }
        stage('install-rocm') {
            steps {
                dir('recipes/python_cython/hip') {
                     sh 'SET_TIMEZONE=1 bash ci/1-install-rocm.sh'
                }
            }
        }
        stage('generate-code') {
            steps {
                dir('recipes/python_cython/hip') {
                     sh 'bash ci/2-generate-code.sh'
                }
            }
        }
    }
}
