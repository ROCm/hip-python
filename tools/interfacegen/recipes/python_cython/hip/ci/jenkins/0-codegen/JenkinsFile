        stage('get-release-repo') {
            options {
                timeout(time: 3, unit: "SECONDS")
            }
            steps {
                dir('recipes/python_cython/hip') {
                    sh 'ls .'
                }
                //  bash ci/0-checkout-release-repo.sh
                //  '''
            }
        }
    }
}