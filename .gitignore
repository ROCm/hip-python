# --- Python bytecode / interpreter caches ---
__pycache__/
*.py[cod]
*$py.class

# --- Cython transpiled C/C++ (generated by Cython, never committed) ---
*.c
*.cpp
# Exception: hand-written C++ source that must be tracked.
!Target.cpp

# --- Compiled extensions ---
*.so
*.dylib
*.dll
*.pyd

# --- pip / build / packaging artifacts ---
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- venv directories ---
.venv/
_venv/
venv/

# --- test / coverage / type & lint caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- editor / OS noise ---
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# --- Sphinx build output ---
_build/
docs/_build/
/docs/

# --- Rendered version files (written at CMake configure; never committed) ---
# VERSION is rendered from the hardcoded HIP_PYTHON_VERSION (and, on
# release branches, the committed VERSION.in template). HIP_PYTHON_VERSION
# and VERSION.in are tracked; only the rendered outputs are ignored.
/VERSION
packages/*/VERSION

# --- Sphinx index.rst rendered from index.rst.in by the docs target ---
docs_src/index.rst
