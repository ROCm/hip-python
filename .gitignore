# --- Python bytecode / interpreter caches ---
__pycache__/
*.py[cod]
*$py.class

# --- Cython transpiled C/C++ (generated by Cython, never committed) ---
*.c
*.cpp

# --- Compiled extensions ---
*.so
*.dylib
*.dll
*.pyd

# --- pip / build / packaging artifacts ---
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- venv directories ---
.venv/
_venv/
venv/

# --- test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- editor / OS noise ---
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# --- Sphinx build output ---
_build/
docs/_build/
/docs/

# --- Codegen-emitted version files (must never be committed on codegen base) ---
/VERSION
/VERSION.in
packages/*/VERSION
