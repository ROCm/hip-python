# \retval     HIPSPARSE_STATUS_SUCCESS the operation completed successfully.
# \retval     HIPSPARSE_STATUS_INVALID_VALUE \p handle, \p m, \p n, \p nnz, \p csrRowPtr, \p csrColInd or
