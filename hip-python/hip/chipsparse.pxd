cdef hipsparseStatus_t hipsparseCgebsr2gebsc_bufferSize(void * handle,int mb,int nb,int nnzb,const float2 * bsrVal,const int * bsrRowPtr,const int * bsrColInd,int rowBlockDim,int colBlockDim,unsigned long * pBufferSizeInBytes)



