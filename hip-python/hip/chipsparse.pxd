#             \p transA == \ref HIPSPARSE_OPERATION_CONJUGATE_TRANSPOSE,
#             \p transB == \ref HIPSPARSE_OPERATION_CONJUGATE_TRANSPOSE or
#             \ref hipsparseMatrixType_t != \ref HIPSPARSE_MATRIX_TYPE_GENERAL.
